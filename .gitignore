# Dependencies
node_modules

# Next.js build output
.next
.next-dev
.next-preview
.vercel
.open-next
.cf

# TypeScript incremental build cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Env
.env.local
.env*.local

# QA reports — auto-generated by scripts/qa-daily.mjs.
# Keep the directory so the script's writes succeed.
qa/reports/*.json
qa/reports/*.md
!qa/reports/.gitkeep

# Logs
*.log

# OS
.DS_Store

# Claude Code agent worktrees (never commit)
.claude/worktrees/
.superpowers/
.worktrees

# Build output from the verify/preview scripts
.next-verify

# Installed skills. skills-lock.json is committed; the installed copies are
# reproducible from it, the same way node_modules is from package-lock.
.claude/skills/

# Tool working directories. These are caches and generated artifacts, not
# source: ~52MB between them, they churn constantly, and nothing in the app
# reads them at build or run time.
.firecrawl/
.planning/
graphify-out/
.agents/

# Generated QA tickets. qa/reports is already ignored; tickets are the same
# class of artifact, written by the nightly QA run.
qa/tickets/
