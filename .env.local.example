# Copy to .env.local and fill in your keys.
# Never commit .env.local — it has secrets.

# Public — safe to expose in browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — used by Edge Functions, never the client
ANTHROPIC_API_KEY=sk-ant-...           # for the draft-message function
OPENAI_API_KEY=sk-...                  # for audio transcription in /voice
STRIPE_SECRET_KEY=sk_test_...          # Stripe Checkout
STRIPE_WEBHOOK_SECRET=whsec_...        # set after wiring webhook in Stripe dashboard
STRIPE_PRICE_ONBOARDING=price_...      # $497 one-time
STRIPE_PRICE_MONTHLY=price_...         # $100/mo subscription
APP_URL=http://localhost:3000
